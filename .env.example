# Google OAuth / Service Account Credentials
GOOGLE_OAUTH_CREDENTIALS=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_SERVICE_ACCOUNT_PATH=

# Google Drive Configuration
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here
DOC_NAME_PATTERN=수업계획서

# Notification Configuration
SENDER_EMAIL=vice_principal@school.edu
EMAIL_SUBJECT_TEMPLATE=[Notice] Lesson Plan Submission Check for {week_label}

# Runtime Mode
MOCK_MODE=false
DRY_RUN=true
